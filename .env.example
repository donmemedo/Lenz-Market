# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated web origins allowed to call the API with the session cookie. "*" is refused.
CORS_ORIGINS=http://localhost:3041
# Must be the same site as the web origin (localhost + localhost, or qaab.ir + api.qaab.ir):
# the session cookie is SameSite=Lax. Locally, browse http://localhost:3041, not 127.0.0.1.
NEXT_PUBLIC_API_URL=http://localhost:8041
# development | production (production: HTTPS-only cookies, HSTS, no /docs, no demo seed)
APP_ENV=development
# 1 = create sample catalogue + the public demo login (always off when APP_ENV=production)
QAAB_SEED_DEMO=1
# Reverse proxy address(es) trusted for X-Forwarded-For
FORWARDED_ALLOW_IPS=127.0.0.1
